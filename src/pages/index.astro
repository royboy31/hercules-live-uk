---
import BaseLayout from '../layouts/BaseLayout.astro';
import Slider from '../components/Slider.astro';
import TopPerformer from '../components/TopPerformer.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import DesignService from '../components/DesignService.astro';
import HerculesMerchandise from '../components/HerculesMerchandise.astro';
import TrustLogos from '../components/TrustLogos.astro';
import CustomerReviews from '../components/CustomerReviews.astro';
import { siteConfig } from '../config/seo';

const WORKER_URL = import.meta.env.WORKER_URL || 'https://hercules-product-sync-uk.gilles-86d.workers.dev';

// Slugs for the 8 homepage spotlight products (order determines carousel order)
const homepageProductSlugs = [
  'baseball-cap',
  'custom-club-slides-and-slippers',
  'custom-printed-pennants',
  'custom-sublimated-towels',
  'custom-football-shirts',
  'custom-football-scarf',
  'custom-football-beanie-hats',
  'custom-made-bucket-hats',
];

// Fetch all 8 products in parallel from the worker at build time
const productResults = await Promise.all(
  homepageProductSlugs.map(async (slug) => {
    try {
      const res = await fetch(`${WORKER_URL}/product/${slug}`);
      if (!res.ok) return null;
      const p = await res.json();
      return {
        id: p.id as number,
        name: p.name as string,
        slug: p.slug as string,
        image: `${WORKER_URL}/image/${p.slug}`,
        alt: (p.images?.[0]?.alt as string) || (p.name as string),
      };
    } catch {
      return null;
    }
  })
);

// Filter out any slugs that failed to load
const products = productResults.filter(Boolean) as Array<{
  id: number;
  name: string;
  slug: string;
  image: string;
  alt: string;
}>;

// SEO configuration for homepage
const pageTitle = 'Custom Sports Merchandise, Teamwear & Football Scarves | Hercules Merchandise';
const pageDescription = 'Your specialist for over 15 years: Custom football and fan scarves, personalised beanies and football merchandise. Made in Europe. Order small quantities now.';
const ogImage = `${siteConfig.siteUrl}${siteConfig.defaultImage}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  pageType="page"
  ogImage={ogImage}
>
  <!-- Hero Slider Section -->
  <Slider />

  <!-- Top Performer in the Spotlight Section -->
  <TopPerformer products={products} />

  <!-- Why Choose Us Section -->
  <WhyChooseUs />

  <!-- Design Service Section -->
  <DesignService />

  <!-- Hercules Merchandise About Section -->
  <HerculesMerchandise />

  <!-- They Trust Us - Trust Logos Section -->
  <TrustLogos />

  <!-- What Customers Say About Us - Customer Reviews Section -->
  <CustomerReviews />
</BaseLayout>
