---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Privacy and Cookie Policy';
const pageDescription = 'Privacy and Cookie Policy of GBI Ventures Ltd trading as Hercules Merchandise - how we collect, use, store and protect your personal data on hercules-merchandise.co.uk.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  pageType="page"
>
  <!-- Breadcrumb -->
  <section class="breadcrumb-section">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol itemscope itemtype="https://schema.org/BreadcrumbList">
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="/" itemprop="item">
              <span itemprop="name">Home</span>
            </a>
            <meta itemprop="position" content="1" />
            <span class="separator"><img src="/images/breadcrumb-separator.svg" alt="" width="6" height="12" /></span>
          </li>
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span itemprop="name">Privacy and Cookie Policy</span>
            <meta itemprop="position" content="2" />
          </li>
        </ol>
      </nav>
    </div>
  </section>

  <!-- Main Content -->
  <section class="page-section">
    <div class="container">
      <div class="content-wrapper">
        <h1>Privacy and Cookie Policy</h1>

        <div class="content-card">
          <div class="intro">
            <p><strong>GBI Ventures Ltd trading as Hercules Merchandise</strong></p>
            <p>Last updated: 01/04/2026</p>
            <p>GBI Ventures Ltd trading as Hercules Merchandise respects your privacy and is committed to protecting your personal data.</p>
            <p>This Privacy and Cookie Policy explains how we collect, use, store and share personal data when you visit our website, request a quote, place an order, approve a design, contact us, subscribe to marketing, or otherwise interact with us.</p>
            <p>Our website is <a href="https://hercules-merchandise.co.uk">hercules-merchandise.co.uk</a>.</p>
            <p>GBI Ventures Ltd is a private limited company registered in England and Wales under company number 15416150, with its registered office at Unit 33, Waterside Schooner Court, 44-48 Wharf Road, London, England, N1 7UX.</p>
            <p>For the purposes of data protection law, GBI Ventures Ltd is the controller of the personal data described in this policy.</p>
            <p>If you have any questions about this Privacy and Cookie Policy or how we use your personal data, please contact us at:</p>
            <p>
              <strong>GBI Ventures Ltd trading as Hercules Merchandise</strong><br>
              Unit 33, Waterside Schooner Court<br>
              44-48 Wharf Road<br>
              London, England<br>
              N1 7UX<br>
              United Kingdom
            </p>
            <p>Email: <a href="mailto:info@hercules-merchandise.co.uk">info@hercules-merchandise.co.uk</a></p>
          </div>

          <div class="legal-section">
            <h2>1. Personal data we collect</h2>
            <p>We may collect and use the following types of personal data.</p>

            <h3>1.1 Information you provide to us</h3>
            <p>We collect personal data when you request a quote, place an order, create an account, approve a design, contact us, subscribe to our newsletter, submit a form, leave a review, or otherwise communicate with us.</p>
            <p>This may include:</p>
            <ul>
              <li>name;</li>
              <li>email address;</li>
              <li>phone number;</li>
              <li>billing address;</li>
              <li>delivery address;</li>
              <li>company, club, team or organisation name;</li>
              <li>job title or role;</li>
              <li>account login details;</li>
              <li>order details;</li>
              <li>quote details;</li>
              <li>payment and invoice details;</li>
              <li>customer service messages;</li>
              <li>newsletter preferences;</li>
              <li>product preferences;</li>
              <li>artwork, logos, badges, images, names, slogans, text or other materials you provide for an order.</li>
            </ul>

            <h3>1.2 Order and design information</h3>
            <p>Because we supply custom-made merchandise, we may collect information relating to your order, including:</p>
            <ul>
              <li>product type;</li>
              <li>quantities;</li>
              <li>sizes;</li>
              <li>colours;</li>
              <li>delivery requirements;</li>
              <li>design instructions;</li>
              <li>approved artwork;</li>
              <li>club, team, business or organisation branding;</li>
              <li>customer-supplied files;</li>
              <li>photographs or videos of products we produce.</li>
            </ul>
            <p>Some customer-supplied artwork or order details may contain personal data, for example names, initials, player names, team details, photographs, school names or club information.</p>

            <h3>1.3 Technical data collected automatically</h3>
            <p>When you use our website, we may automatically collect technical information, such as:</p>
            <ul>
              <li>IP address;</li>
              <li>browser type and version;</li>
              <li>device type;</li>
              <li>operating system;</li>
              <li>time zone;</li>
              <li>pages visited;</li>
              <li>time and date of visit;</li>
              <li>referring website;</li>
              <li>files viewed, submitted or downloaded;</li>
              <li>interactions with the website;</li>
              <li>cookie and analytics data.</li>
            </ul>
            <p>We use this information to operate, secure, analyse and improve our website.</p>

            <h3>1.4 Payment data</h3>
            <p>Payments may be processed by third-party payment providers. We do not store your full card details.</p>
            <p>We may receive limited payment information, such as confirmation that payment has been made, the amount paid, payment date, payment reference, billing details and invoice status.</p>

            <h3>1.5 Public information</h3>
            <p>If you post information in public areas of our website, such as comments, reviews or testimonials, that information may be visible to other users.</p>
          </div>

          <div class="legal-section">
            <h2>2. How we collect personal data</h2>
            <p>We may collect personal data:</p>
            <ul>
              <li>directly from you;</li>
              <li>through our website forms;</li>
              <li>through quote requests;</li>
              <li>through account registration;</li>
              <li>through email, phone or other communications;</li>
              <li>when you place or approve an order;</li>
              <li>when you upload artwork or files;</li>
              <li>when you subscribe to marketing;</li>
              <li>through cookies and similar technologies;</li>
              <li>from payment providers, delivery partners, production partners or other service providers;</li>
              <li>from publicly available sources, where relevant to an order or enquiry.</li>
            </ul>
          </div>

          <div class="legal-section">
            <h2>3. How we use your personal data and our lawful bases</h2>
            <p>We only use personal data where we have a lawful basis to do so.</p>

            <div class="legal-table-wrapper">
              <table class="legal-table">
                <thead>
                  <tr>
                    <th>Purpose</th>
                    <th>Personal data used</th>
                    <th>Lawful basis</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>To respond to enquiries and quote requests</td>
                    <td>Name, contact details, enquiry details, product requirements</td>
                    <td>Contract or legitimate interests</td>
                  </tr>
                  <tr>
                    <td>To prepare quotes and designs</td>
                    <td>Contact details, order details, artwork, logos, product specifications</td>
                    <td>Contract or legitimate interests</td>
                  </tr>
                  <tr>
                    <td>To process and fulfil orders</td>
                    <td>Name, contact details, billing details, delivery details, order details, artwork</td>
                    <td>Contract</td>
                  </tr>
                  <tr>
                    <td>To create and manage customer accounts</td>
                    <td>Name, email address, login details, order history</td>
                    <td>Contract or legitimate interests</td>
                  </tr>
                  <tr>
                    <td>To take payment and issue invoices</td>
                    <td>Billing details, payment confirmation, invoice details</td>
                    <td>Contract and legal obligation</td>
                  </tr>
                  <tr>
                    <td>To arrange production and delivery</td>
                    <td>Name, delivery details, order details, artwork, product details</td>
                    <td>Contract</td>
                  </tr>
                  <tr>
                    <td>To provide customer service</td>
                    <td>Contact details, correspondence, order history</td>
                    <td>Contract or legitimate interests</td>
                  </tr>
                  <tr>
                    <td>To deal with faulty goods, complaints or disputes</td>
                    <td>Order details, correspondence, images, delivery details, evidence</td>
                    <td>Contract, legal obligation or legitimate interests</td>
                  </tr>
                  <tr>
                    <td>To keep accounting, tax and business records</td>
                    <td>Invoice details, payment details, order records</td>
                    <td>Legal obligation</td>
                  </tr>
                  <tr>
                    <td>To protect our website and prevent fraud</td>
                    <td>Technical data, account data, order data, payment indicators</td>
                    <td>Legitimate interests</td>
                  </tr>
                  <tr>
                    <td>To improve our website and services</td>
                    <td>Technical data, analytics data, order trends, feedback</td>
                    <td>Legitimate interests or consent where required</td>
                  </tr>
                  <tr>
                    <td>To send newsletters and marketing</td>
                    <td>Name, email address, marketing preferences, customer history</td>
                    <td>Consent or legitimate interests where permitted</td>
                  </tr>
                  <tr>
                    <td>To use product images, portfolio examples and case studies</td>
                    <td>Product photos, general order details, club/team/business name, logos or branding</td>
                    <td>Legitimate interests, or consent where required</td>
                  </tr>
                  <tr>
                    <td>To comply with legal obligations</td>
                    <td>Relevant personal data depending on the obligation</td>
                    <td>Legal obligation</td>
                  </tr>
                  <tr>
                    <td>To establish, exercise or defend legal claims</td>
                    <td>Relevant order, payment, correspondence or account data</td>
                    <td>Legitimate interests or legal obligation</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <p>Where we rely on legitimate interests, this means we use personal data for our commercial and business interests in a way that we believe is reasonable, proportionate and expected, while taking account of your rights and freedoms.</p>
          </div>

          <div class="legal-section">
            <h2>4. Marketing communications</h2>
            <p>We may use your contact details to send you updates about our products, services, offers, news and examples of our work.</p>
            <p>We will only send marketing emails where permitted by law. This may be because you have subscribed, because you have given consent, or because you are an existing customer and the law allows us to contact you about our own similar products or services.</p>
            <p>Where we rely on the soft opt-in for existing customers, we will give you a clear opportunity to opt out when we collect your details and in every marketing email we send.</p>
            <p>You can unsubscribe from marketing emails at any time by clicking the unsubscribe link in our emails or by contacting us.</p>
            <p>We do not sell your personal data to third parties for their own marketing.</p>
          </div>

          <div class="legal-section">
            <h2>5. Marketing, portfolio use and case studies</h2>
            <p>We may use photographs or videos of products we have designed, produced or supplied, together with general information about the order, for our marketing, portfolio, blog, social media, catalogue, email newsletter, presentation and promotional purposes.</p>
            <p>This may include:</p>
            <ul>
              <li>photographs and videos of finished products;</li>
              <li>product designs, mockups, samples and visuals;</li>
              <li>your club, team, organisation, business or brand name;</li>
              <li>logos, badges, crests, colours, slogans, artwork or branding supplied or approved by you;</li>
              <li>general information about the order, such as product type, sport, location, project purpose or nature of the merchandise.</li>
            </ul>
            <p>Our lawful basis for this is usually our legitimate interest in promoting our business and showing examples of our work.</p>
            <p>We will not publish private contact details, personal addresses, confidential pricing, unpublished personal information, sensitive information or commercially confidential information without permission.</p>
            <p>Where marketing use involves identifiable individuals, children, private individuals or other personal data, we will consider whether additional permission is required and will handle that information in accordance with data protection law.</p>
            <p>If you do not want us to use your order, name, branding or product images for marketing, please tell us in writing before approving your order. You may also object to this type of use by contacting us.</p>
          </div>

          <div class="legal-section">
            <h2>6. Customer-supplied artwork and personal data</h2>
            <p>If you provide artwork, logos, badges, photographs, names, text or other materials for use in an order, you are responsible for ensuring that you have the right to provide them to us.</p>
            <p>Where customer-supplied materials include personal data, you must ensure that you have any necessary permissions or lawful basis to share that personal data with us for the purpose of preparing designs, manufacturing products, fulfilling the order and, where applicable, using product images or order examples for marketing.</p>
            <p>This is especially important where materials include names, images or details of children, team members, employees, private individuals or other identifiable people.</p>
            <p>We do not intentionally collect special category personal data unless you choose to provide it to us. Special category data may include information about health, religion, ethnicity, political opinions or similar protected information. Please avoid providing this type of information unless it is necessary for your order.</p>
          </div>

          <div class="legal-section">
            <h2>7. Cookies and similar technologies</h2>
            <p>We use cookies and similar technologies on our website.</p>
            <p>Cookies are small text files placed on your device when you visit a website. Similar technologies may include pixels, tags, scripts, local storage and other tools that store or access information on your device.</p>
            <p>We use cookies and similar technologies to operate our website, keep it secure, improve performance, remember preferences, analyse website traffic, understand how visitors use our website and, where applicable, support marketing.</p>

            <h3>7.1 Types of cookies we use</h3>
            <p>We may use the following types of cookies:</p>

            <div class="legal-table-wrapper">
              <table class="legal-table">
                <thead>
                  <tr>
                    <th>Type of cookie</th>
                    <th>Purpose</th>
                    <th>Consent required?</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Strictly necessary cookies</td>
                    <td>These are needed for the website to work properly, for example security, page navigation, quote forms, account login, checkout or remembering items in a basket.</td>
                    <td>No</td>
                  </tr>
                  <tr>
                    <td>Functional cookies</td>
                    <td>These help remember choices you make, such as language, region, saved preferences or form settings.</td>
                    <td>Usually yes</td>
                  </tr>
                  <tr>
                    <td>Analytics or performance cookies</td>
                    <td>These help us understand how visitors use the website, which pages are visited, how users interact with the site and how we can improve it.</td>
                    <td>Usually yes</td>
                  </tr>
                  <tr>
                    <td>Marketing or advertising cookies</td>
                    <td>These may be used to measure marketing performance, personalise advertising, support remarketing or track interactions with marketing campaigns.</td>
                    <td>Yes</td>
                  </tr>
                  <tr>
                    <td>Third-party cookies</td>
                    <td>These may be set by third-party services used on our website, such as analytics providers, video embeds, maps, social media tools or advertising platforms.</td>
                    <td>Usually yes</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <h3>7.2 Strictly necessary cookies</h3>
            <p>Some cookies are essential for our website to function. These may be used for purposes such as:</p>
            <ul>
              <li>website security;</li>
              <li>fraud prevention;</li>
              <li>remembering privacy or cookie choices;</li>
              <li>enabling quote, account or checkout functions;</li>
              <li>maintaining website performance;</li>
              <li>keeping the website available and reliable.</li>
            </ul>
            <p>These cookies do not require consent because they are necessary to provide the website or services you request.</p>

            <h3>7.3 Functional cookies</h3>
            <p>Functional cookies help us provide additional features and remember choices you make, such as language, region, preferences or form information.</p>
            <p>Where functional cookies are not strictly necessary, we will only use them where permitted by law and, where required, with your consent.</p>

            <h3>7.4 Analytics cookies</h3>
            <p>We may use analytics cookies to understand how visitors use our website.</p>
            <p>These cookies help us see information such as which pages are visited, how long visitors stay, which pages are popular, how visitors reach our website and whether the website is working properly.</p>
            <p>We use this information to improve our website, products, user experience and marketing.</p>
            <p>Analytics cookies will only be used where permitted by law and, where required, with your consent.</p>

            <h3>7.5 Marketing cookies</h3>
            <p>We may use marketing cookies or similar technologies to measure the effectiveness of our marketing, understand customer interests, show relevant advertising, support remarketing campaigns or measure interactions with our content.</p>
            <p>Marketing cookies will only be used where permitted by law and, where required, with your consent.</p>

            <h3>7.6 Third-party cookies and services</h3>
            <p>Some cookies or similar technologies may be placed by third-party services used on our website.</p>
            <p>These may include services for:</p>
            <ul>
              <li>website analytics;</li>
              <li>payment processing;</li>
              <li>website security;</li>
              <li>embedded videos;</li>
              <li>maps;</li>
              <li>social media features;</li>
              <li>advertising;</li>
              <li>remarketing;</li>
              <li>marketing performance measurement.</li>
            </ul>
            <p>Third-party providers may process information about your use of our website in accordance with their own privacy and cookie policies.</p>
            <p>Where required, these third-party cookies will only be used with your consent.</p>

            <h3>7.7 Managing your cookie preferences</h3>
            <p>When you visit our website, you may be asked to accept, reject or manage non-essential cookies.</p>
            <p>You can change or withdraw your cookie consent at any time by using the cookie settings tool on our website, where available.</p>
            <p>You can also control cookies through your browser settings. Most browsers allow you to block cookies, delete cookies or receive a warning before cookies are stored.</p>
            <p>If you block certain cookies, parts of our website may not work properly.</p>

            <h3>7.8 Cookie list</h3>
            <p>The specific cookies used on our website may depend on the tools and services active at the time of your visit.</p>
            <p>Where possible, our cookie banner or cookie settings tool will provide details of the specific cookies in use, including their purpose and duration.</p>
            <p>We may update the cookies we use from time to time as our website and services change.</p>
          </div>

          <div class="legal-section">
            <h2>8. Who we share personal data with</h2>
            <p>We may share personal data where necessary for the purposes described in this policy.</p>
            <p>This may include sharing personal data with:</p>
            <ul>
              <li>payment providers;</li>
              <li>delivery and courier companies;</li>
              <li>manufacturers, production partners and suppliers;</li>
              <li>IT, website hosting and cloud service providers;</li>
              <li>email and newsletter platforms;</li>
              <li>analytics providers;</li>
              <li>customer support systems;</li>
              <li>accountants, bookkeepers and tax advisers;</li>
              <li>legal advisers and insurers;</li>
              <li>fraud prevention or security providers;</li>
              <li>professional advisers;</li>
              <li>regulators, public authorities, courts or law enforcement where required;</li>
              <li>another business if we sell, transfer or restructure all or part of our business.</li>
            </ul>
            <p>We only share personal data where we have a lawful basis to do so and where it is necessary for the relevant purpose.</p>
            <p>We do not sell or rent personal data to third parties.</p>
          </div>

          <div class="legal-section">
            <h2>9. International transfers</h2>
            <p>Some of our suppliers or service providers may process personal data outside the United Kingdom.</p>
            <p>Where personal data is transferred outside the UK, we will take appropriate steps to ensure that it is protected in accordance with applicable data protection laws. This may include using providers located in countries recognised as providing adequate protection or using appropriate contractual safeguards.</p>
          </div>

          <div class="legal-section">
            <h2>10. How long we keep personal data</h2>
            <p>We keep personal data only for as long as necessary for the purposes for which it was collected, including to provide services, fulfil orders, keep business records, comply with legal obligations, resolve disputes and enforce agreements.</p>
            <p>In general:</p>
            <ul>
              <li>enquiry and quote records may be kept for as long as reasonably necessary to respond to you, manage repeat enquiries and maintain business records;</li>
              <li>order, invoice, tax and accounting records may be kept for the period required for tax, accounting and legal purposes;</li>
              <li>customer service correspondence may be kept for as long as reasonably necessary to deal with enquiries, complaints, repeat orders or legal claims;</li>
              <li>customer account data may be kept while your account remains active and for a reasonable period afterwards;</li>
              <li>newsletter and marketing data is kept until you unsubscribe, object, withdraw consent or ask us to delete it, unless we need to keep limited information to record your marketing preferences;</li>
              <li>product photographs, portfolio examples and case studies may be kept for as long as they remain relevant to our business, unless you object and we agree or are required to remove them;</li>
              <li>website analytics data is kept according to the retention settings of the analytics tools we use.</li>
            </ul>
            <p>If we no longer need personal data, we will delete it, anonymise it or securely archive it.</p>
          </div>

          <div class="legal-section">
            <h2>11. Security</h2>
            <p>We take appropriate technical, organisational and administrative measures to protect personal data against unauthorised access, loss, misuse, alteration or disclosure.</p>
            <p>Access to personal data is limited to people and service providers who need it for legitimate business purposes.</p>
            <p>However, no method of online transmission or electronic storage is completely secure. If you are concerned about sending certain information online, please contact us to discuss alternative options.</p>
          </div>

          <div class="legal-section">
            <h2>12. Your rights</h2>
            <p>Depending on the circumstances, you may have the right to:</p>
            <ul>
              <li>request access to the personal data we hold about you;</li>
              <li>request correction of inaccurate or incomplete personal data;</li>
              <li>request deletion of your personal data;</li>
              <li>request restriction of our use of your personal data;</li>
              <li>object to our use of your personal data;</li>
              <li>object to direct marketing;</li>
              <li>request transfer of your personal data to another provider, where applicable;</li>
              <li>withdraw consent where we rely on consent;</li>
              <li>object to automated decision-making or profiling, where applicable.</li>
            </ul>
            <p>To exercise your rights, please contact us using the details in this policy.</p>
            <p>We may ask for proof of identity before responding to a request.</p>
            <p>Your rights are not absolute and may depend on the circumstances. For example, we may need to keep certain information to comply with legal obligations, complete an order, resolve disputes or keep necessary business records.</p>
          </div>

          <div class="legal-section">
            <h2>13. Children&rsquo;s personal data</h2>
            <p>Our website and services are not aimed directly at children.</p>
            <p>However, because we produce sports merchandise, customer-supplied artwork or order details may sometimes include children&rsquo;s names, team names, photographs, initials or other information.</p>
            <p>If you provide personal data relating to children, you must ensure that you have the necessary authority, permission or lawful basis to provide that information to us for the relevant order.</p>
            <p>We will take particular care when handling personal data relating to children, especially where photographs, names or identifiable information may be used in product designs, portfolio examples or marketing.</p>
          </div>

          <div class="legal-section">
            <h2>14. Automated decision-making</h2>
            <p>We do not use your personal data to make decisions based solely on automated processing that have legal or similarly significant effects on you.</p>
            <p>If this changes, we will update this policy and provide any information required by law.</p>
          </div>

          <div class="legal-section">
            <h2>15. Complaints</h2>
            <p>If you are unhappy with how we use your personal data, please contact us first so we can try to resolve the issue.</p>
            <p>You also have the right to complain to the Information Commissioner&rsquo;s Office, the UK data protection regulator.</p>
          </div>

          <div class="legal-section">
            <h2>16. Third-party links</h2>
            <p>Our website may contain links to third-party websites, platforms or services.</p>
            <p>We are not responsible for the privacy practices, content or security of third-party websites. You should read their privacy policies before providing personal data to them.</p>
          </div>

          <div class="legal-section">
            <h2>17. Changes to this Privacy and Cookie Policy</h2>
            <p>We may update this Privacy and Cookie Policy from time to time.</p>
            <p>The latest version will be published on our website with the updated date shown at the top.</p>
            <p>Where changes are significant, we may take additional steps to bring them to your attention, such as displaying a notice on our website, contacting you by email, or asking you to review your cookie preferences again.</p>
          </div>

          <div class="legal-section">
            <h2>18. Contact us</h2>
            <p>If you have any questions about this Privacy and Cookie Policy or how we handle personal data, please contact us:</p>
            <p>
              <strong>GBI Ventures Ltd trading as Hercules Merchandise</strong><br>
              Unit 33, Waterside Schooner Court<br>
              44-48 Wharf Road<br>
              London, England<br>
              N1 7UX<br>
              United Kingdom
            </p>
            <p>
              Company number: 15416150<br>
              Email: <a href="mailto:info@hercules-merchandise.co.uk">info@hercules-merchandise.co.uk</a><br>
              Website: <a href="https://hercules-merchandise.co.uk">hercules-merchandise.co.uk</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb-section {
    background: #FAFAFA;
    padding: 15px 0;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .breadcrumb {
    font-family: 'Jost', sans-serif;
    font-size: 14px;
  }

  .breadcrumb ol {
    display: flex;
    align-items: center;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumb li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .breadcrumb a {
    color: #787878;
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: #469ADC;
  }

  .breadcrumb li:last-child span {
    color: #469ADC;
  }

  .breadcrumb .separator {
    display: flex;
    align-items: center;
  }

  .page-section {
    background: #FAFAFA;
    padding: 40px 0 80px;
  }

