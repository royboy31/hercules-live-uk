    align-items: center;
    gap: 10px;
  }

  .breadcrumb a {
    color: #787878;
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: #469ADC;
  }

  .breadcrumb li:last-child span {
    color: #469ADC;
  }

  .breadcrumb .separator {
    display: flex;
    align-items: center;
  }

  .page-section {
    background: #FAFAFA;
    padding: 40px 0 80px;
  }

  .content-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  h1 {
    font-family: 'Jost', sans-serif;
    font-size: 42px;
    font-weight: 600;
    color: #253461;
    text-align: center;
    margin-bottom: 40px;
    text-transform: uppercase;
